generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Event {
  id            String    @id @default(uuid())
  customer_id   String
  status        String    @default("pending")
  retry_count   Int       @default(0)
  data          String    
  next_retry_at DateTime  @default(now())
  last_retry_at DateTime?
}